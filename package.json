{
  "name": "typora-replica",
  "productName": "墨页 Moye",
  "version": "0.9.13",
  "private": true,
  "description": "保留 Markdown 原文的即时排版桌面编辑器",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs",
    "package:zip": "npm run build && node scripts/package.mjs --zip"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/open-sans": "5.2.7",
    "@lezer/highlight": "1.2.5",
    "@vscode/codicons": "0.0.46-24",
    "dompurify": "3.4.17",
    "fast-diff": "1.3.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.0",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.5.438",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
